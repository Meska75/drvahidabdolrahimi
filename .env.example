# این فایل فقط نمونه است — روی سرور یک کپی با نام .env و مقادیر واقعی بسازید
# هرگز .env واقعی را commit نکنید

# اگر کلید کاراکتر خاص دارد، حتماً داخل دابل‌کوت بگذارید
SECRET_KEY="یک_کلید_تصادفی_بلند_اینجا"
DEBUG=False
ALLOWED_HOSTS=drabdolrahimi.ir,www.drabdolrahimi.ir,drabdolrahimi.com,www.drabdolrahimi.com

# دیتابیس PostgreSQL روی خود سرور سایت
DB_NAME=drabdolrahimi
DB_USER=drabdolrahimi
